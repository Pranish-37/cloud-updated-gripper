<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>teleop_node</name>
  <version>0.1.0</version>
  <description>
    Keyboard + SpaceMouse teleoperation node for xArm.
    Publishes 7-vector action commands to policy/action_cmd.
    Requires xarm_driver_node running with servo_mode:=true.
  </description>
  <maintainer email="todo@todo.com">CloudGripper</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
